// agent-eval 数据模型
//
// 只有一张表：Span。一次 Agent 运行（run）会产生多个 span，
// 每个 span 是这次运行本身、一次 LLM 调用、或一次工具调用。
//
// Stage 0：每个 run 只有一个 span（llm_call），parentId 恒为 null。
// Stage 1：一次运行产生多个 span，parentId 串成 trace 树，多了一个 agent_run 根节点。
//          表结构一行没改 —— 只往 type 列加了个新值，这正是当初选 String 而非 enum 的回报。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // 应用连库走**连接池**。Vercel 是 serverless，每个请求可能落在新进程里，
  // 直连会把 Neon 的连接数用光。POSTGRES_PRISMA_URL 由 Vercel 的 Neon 集成
  // 注入，主机名里带 -pooler。
  url = env("POSTGRES_PRISMA_URL")

  // 跑迁移走**直连**（主机名不带 -pooler）。连接池（pgbouncer）不支持迁移
  // 要用的部分 SQL 语句，所以 prisma migrate 必须绕开它。
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

/// 一次调用（LLM 调用或工具调用）的记录。
/// 字段命名参考 OpenTelemetry 的 LLM span 语义约定。
model Span {
  id       String  @id @default(cuid())
  /// 同一次运行的所有 span 共享这个 id。一次运行至少有根节点那一个 span。
  runId    String
  /// 自关联成 trace 树。null 表示这次运行的根节点（agent_run）。
  parentId String?

  /// "agent_run" | "llm_call" | "tool_call"
  /// 用 String 而非 enum：TS 侧已有 SpanType 联合类型兜住类型安全，
  /// 再加一层 DB enum 只会让每次增删类型都多一道迁移。
  type String

  /// span 名称，便于在树上辨认，例如 "deepseek-flash" 或工具名
  name String

  /// 入参的 JSON 字符串（prompt、模型、参数等）
  /// 用 String 存 JSON 而非 Json 类型：读时手动 parse（已封装在 lib/spans.ts），
  /// 换来的是换库或换 ORM 时不用动列类型。
  input  String
  /// 出参的 JSON 字符串（模型返回的文本、finishReason 等）
  output String?

  model        String?
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int?

  createdAt DateTime @default(now())

  // 自关联：一个 span 有一个父 span，可以有多个子 span
  parent   Span?  @relation("SpanTree", fields: [parentId], references: [id])
  children Span[] @relation("SpanTree")

  @@index([runId])
  @@index([createdAt])
}
