# 环境变量模板 —— 复制成 .env 后填入真实值
#   cp .env.example .env
#
# .env 是 gitignore 的，.env.example 是提交的。新增环境变量时两边都要改。

# ── 数据库（Neon Postgres）───────────────────────────────────────
# 线上：由 Vercel 的 Neon 集成自动注入，不用手填。
# 本地：从 Neon 控制台（console.neon.tech）的 Connect 面板复制。
#
# 两个连接串用途不同，别混用：
#
# 1) 应用连库 —— 走连接池。Vercel 是 serverless，每个请求可能落在新进程里，
#    直连会把 Neon 的连接数用光。特征：主机名里有 -pooler。
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
#
# 2) 跑迁移 —— 走直连。连接池（pgbouncer）不支持迁移要用的部分 SQL 语句。
#    特征：主机名里没有 -pooler。
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── LLM ────────────────────────────────────────────────────────
# 去 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
